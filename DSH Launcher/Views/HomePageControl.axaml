<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="500"
             x:Class="DSH_Launcher.Views.HomePageControl">

    <StackPanel Margin="30 20 30 20">
        <Expander x:Name="DshExpander"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch">
            <Expander.Header>
                <Grid ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12"
                      Margin="0 4">
                    <!-- 左侧:安装状态 / 版本号 -->
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               x:Name="StatusText"
                               VerticalAlignment="Center"
                               Text="检查中..."/>

                    <!-- 右侧:操作按钮(按状态分三组显示,互斥) -->
                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <ui:FAProgressRing x:Name="HeaderProgress"
                                           Width="20"
                                           Height="20"
                                           IsActive="False"/>

                        <!-- 未安装:安装 -->
                        <StackPanel x:Name="InstallActionsPanel"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button x:Name="InstallButton"
                                    Classes="accent"
                                    Click="OnInstallClick"
                                    ToolTip.Tip="npm install -g @deepseek-ai/dsh">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="InstallButtonText" Text="安装" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- 已安装未运行:运行 -->
                        <StackPanel x:Name="RunActionsPanel"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <!-- 检测到新版本时才显示 -->
                            <Button x:Name="UpdateButton"
                                    Classes="accent"
                                    IsVisible="False"
                                    Click="OnUpdateClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="更新" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="端口"
                                       VerticalAlignment="Center"
                                       Opacity="0.8"/>
                            <TextBox x:Name="PortTextBox"
                                     Width="70"
                                     VerticalAlignment="Center"
                                     PlaceholderText="3080"
                                     TextInput="OnPortTextInput"
                                     LostFocus="OnPortLostFocus"
                                     ToolTip.Tip="1-65535;留空则使用 dsh 默认端口 3080"/>
                            <Button x:Name="RunButton"
                                    Classes="accent"
                                    Click="OnRunClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="运行" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- 运行中:打开 / 重启 / 停止 -->
                        <StackPanel x:Name="RunningActionsPanel"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button x:Name="OpenInWebViewButton"
                                    IsVisible="False"
                                    Click="OnOpenInWebViewClick"
                                    ToolTip.Tip="在应用内 WebView 窗口中打开 Web 端">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE774;" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="WebView中打开" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="OpenInBrowserButton"
                                    IsVisible="False"
                                    Click="OnOpenInBrowserClick"
                                    ToolTip.Tip="在系统默认浏览器中打开 Web 端">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A7;" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="浏览器中打开" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RestartButton"
                                    Click="OnRestartClick"
                                    ToolTip.Tip="停止并重新启动 dsh 服务">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="重启" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopButton"
                                    Click="OnStopClick"
                                    Background="#C42B1C"
                                    Foreground="White"
                                    ToolTip.Tip="停止 dsh 服务">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xF8AE;" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="停止" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Expander.Header>
            <!-- 展开后显示 stdio 输出 -->
            <ScrollViewer x:Name="LogScroll"
                          Height="280"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock x:Name="LogTextBlock"
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     LineHeight="18"/>
            </ScrollViewer>
        </Expander>

        <Grid Height="30"/>
    </StackPanel>
</UserControl>
