<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DSH_Launcher.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="400"
             x:Class="DSH_Launcher.Views.SettingsPageControl">

    <!-- 内容超出可视高度时可滚动:窗口高度较小时(最小 480)否则会直接裁掉底部的设置项 -->
    <ScrollViewer x:Name="SettingsScroll"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <TextBlock Text="服务" FontSize="16" FontWeight="SemiBold"/>

            <!-- 启动时打开主界面 -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0 4 0 0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="启动时打开主界面"/>
                    <TextBlock Text="应用启动后直接显示主窗口;关闭时启动到系统托盘"
                               FontSize="12"
                               Opacity="0.7"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <ToggleSwitch x:Name="ShowMainWindowOnStartupSwitch"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              IsCheckedChanged="OnShowMainWindowOnStartupChanged"/>
            </Grid>

            <!-- 启动时运行 DSH 服务 -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0 4 0 0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="启动时运行DSH服务"/>
                    <TextBlock Text="应用启动后自动运行 dsh web(需已安装 @deepseek-ai/dsh)"
                               FontSize="12"
                               Opacity="0.7"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <ToggleSwitch x:Name="RunDshServiceOnStartupSwitch"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              IsCheckedChanged="OnRunDshServiceOnStartupChanged"/>
            </Grid>

            <!-- 启动DSH服务后 -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0 4 0 0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="启动DSH服务后"/>
                    <TextBlock Text="DSH 服务启动并检测到 Web 地址后自动打开的方式"
                               FontSize="12"
                               Opacity="0.7"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <ComboBox x:Name="AfterDshServiceStartedCombo"
                          Grid.Column="1"
                          Width="180"
                          SelectionChanged="OnAfterDshServiceStartedChanged">
                    <ComboBoxItem Content="无动作"/>
                    <ComboBoxItem Content="打开WebView"/>
                    <ComboBoxItem Content="打开浏览器"/>
                </ComboBox>
            </Grid>



            <TextBlock Text="系统托盘"
                       FontSize="16" FontWeight="SemiBold"
                       Margin="0 24 0 8"/>

            <!-- 单击托盘图标 -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0 4 0 0">
                <TextBlock Text="单击托盘图标" VerticalAlignment="Center"/>
                <ComboBox x:Name="TraySingleClickCombo"
                          Grid.Column="1"
                          Width="180"
                          SelectionChanged="OnTraySingleClickChanged">
                    <ComboBoxItem Content="无动作"/>
                    <ComboBoxItem Content="在WebView中打开"/>
                    <ComboBoxItem Content="在浏览器中打开"/>
                    <ComboBoxItem Content="打开界面"/>
                </ComboBox>
            </Grid>

            <!-- 双击托盘图标 -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0 8 0 0">
                <TextBlock Text="双击托盘图标" VerticalAlignment="Center"/>
                <ComboBox x:Name="TrayDoubleClickCombo"
                          Grid.Column="1"
                          Width="180"
                          SelectionChanged="OnTrayDoubleClickChanged">
                    <ComboBoxItem Content="无动作"/>
                    <ComboBoxItem Content="在WebView中打开"/>
                    <ComboBoxItem Content="在浏览器中打开"/>
                    <ComboBoxItem Content="打开界面"/>
                </ComboBox>
            </Grid>

            <TextBlock Text="WebView"
                       FontSize="16" FontWeight="SemiBold"
                       Margin="0 24 0 8"/>

            <!-- WebView 内打开链接 -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0 4 0 0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="WebView 内打开链接"/>
                    <TextBlock Text="在应用内 WebView 里点击链接（或页面请求新窗口）时用哪种方式打开"
                               FontSize="12"
                               Opacity="0.7"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <ComboBox x:Name="WebViewLinkCombo"
                          Grid.Column="1"
                          Width="180"
                          SelectionChanged="OnWebViewLinkChanged">
                    <ComboBoxItem Content="系统浏览器"/>
                    <ComboBoxItem Content="在WebView中打开"/>
                    <ComboBoxItem Content="交给默认处理"/>
                </ComboBox>
            </Grid>

            <!-- 关闭后是否保留 WebView 窗口 -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0 12 0 0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="保留 WebView 窗口"/>
                    <TextBlock Text="关闭窗口时只隐藏,下次打开无需重新加载;会持续占用 WebView2 内存。关闭则关闭即释放"
                               FontSize="12"
                               Opacity="0.7"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <ToggleSwitch x:Name="KeepWebViewAliveSwitch"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              IsCheckedChanged="OnKeepWebViewAliveChanged"/>
            </Grid>

            <!-- 保留超时:仅在“保留 WebView 窗口”开启时可编辑 -->
            <Grid x:Name="WebViewIdleTimeoutPanel"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="12"
                  Margin="0 4 0 0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="保留超时（分钟）"/>
                    <TextBlock Text="隐藏超过该时长后自动关闭窗口并释放 WebView2 内存;留空使用默认 5 分钟"
                               FontSize="12"
                               Opacity="0.7"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <controls:NumericUpDownWithDefault x:Name="WebViewIdleTimeoutBox"
                                                   Grid.Column="1"
                                                   Width="180"
                                                   VerticalAlignment="Center"
                                                   Minimum="1"
                                                   Maximum="1440"
                                                   Increment="1"
                                                   ClipValueToMinMax="True"
                                                   DefaultValue="5"
                                                   PlaceholderText="5"
                                                   ValueChanged="OnWebViewIdleTimeoutChanged"
                                                   ToolTip.Tip="1-1440 分钟;留空则使用默认 5 分钟"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
