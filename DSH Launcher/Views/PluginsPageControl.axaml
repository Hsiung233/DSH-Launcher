<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:svc="using:DSH_Launcher.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="DSH_Launcher.Views.PluginsPageControl">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- 日志区凹陷底色(与首页一致的取色方式:浅色主题下 Fluent 的填充色几乎看不出层次) -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CodeAreaFillBrush" Color="#0F000000"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CodeAreaFillBrush" Color="#14FFFFFF"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 列表容器:用 VirtualizingStackPanel 把 ItemsControl 变成虚拟化列表。
                 ItemsControl 默认的 StackPanel **不虚拟化** —— 152 条组合条目会被全部实例化并参与测量排布
                 (实测 UIA 里能看到 152 个启停按钮);换成这个后只实现可视区域内的那几行 -->
            <ItemsPanelTemplate x:Key="PluginListPanel">
                <VirtualizingStackPanel/>
            </ItemsPanelTemplate>

            <!-- 插件行:已安装列表与“全部组合条目”共用同一套模板。
                 右边距 16:Fluent 的滚动条是 overlay(画在内容之上),只留 8 会压住行尾的按钮。
                 最左是批量选择框:绑定在数据对象的 IsSelected 上 ——
                 列表是虚拟化的(容器会被回收),勾选态存在行上会错位 -->
            <DataTemplate x:Key="PluginRowTemplate" x:DataType="svc:PluginEntry">
                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="0 8 16 8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <CheckBox Grid.Column="0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  ToolTip.Tip="勾选后可批量启用/禁用/恢复默认/卸载"/>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding VersionText}"
                                           FontSize="12"
                                           Opacity="0.7"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding OriginText}" FontSize="12" Opacity="0.7"/>
                                <TextBlock Text="·" FontSize="12" Opacity="0.5"/>
                                <TextBlock Text="{Binding StateText}" FontSize="12" Opacity="0.7"/>
                                <TextBlock Text="{Binding Id}"
                                           FontSize="12"
                                           Opacity="0.5"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button x:Name="TogglePluginButton"
                                    Content="{Binding ToggleText}"
                                    IsVisible="{Binding CanToggle}"
                                    Click="OnToggleEntryClick"
                                    ToolTip.Tip="{Binding ToggleToolTip}"/>
                            <Button Content="恢复默认"
                                    IsVisible="{Binding HasOverride}"
                                    Click="OnClearOverrideClick"
                                    ToolTip.Tip="删除启动器写入的启停覆盖,回到插件自带的状态"/>
                            <Button Content="卸载"
                                    IsVisible="{Binding CanUninstall}"
                                    Click="OnUninstallClick"
                                    ToolTip.Tip="从 profile 移除该包(再点一次确认)"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- 插件目录条目行(数据来自策展目录,不是 npm registry)。
                 右边距 16 同上:给 overlay 滚动条留出槽位 -->
            <DataTemplate x:Key="CatalogRowTemplate" x:DataType="svc:PluginCatalogEntry">
                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="0 10 16 10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding VersionText}"
                                           FontSize="12"
                                           Opacity="0.7"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SourceText}"
                                           FontSize="12"
                                           Opacity="0.55"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding OwnerText}"
                                           FontSize="12"
                                           Opacity="0.55"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- dsh-plugin.org 会标注人工验证(awesome-dsh-plugin 没有这个字段) -->
                                <Border IsVisible="{Binding Verified}"
                                        VerticalAlignment="Center"
                                        CornerRadius="10"
                                        Padding="6 1"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock Text="已人工验证"
                                               FontSize="11"
                                               Opacity="0.8"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}"
                                       FontSize="12"
                                       Opacity="0.7"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding MetaText}"
                                       FontSize="12"
                                       Opacity="0.55"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Content="安装"
                                    Click="OnInstallCatalogEntryClick"
                                    ToolTip.Tip="按目录给的来源安装(装不上会自动回退到目录给的备选来源)"/>
                            <Button Content="详情"
                                    Click="OnOpenCatalogPageClick"
                                    ToolTip.Tip="在浏览器里打开目录页面(截图/评论/仓库链接)"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ① 页头:插件标题 + pnpm 状态徽标 + 目录说明,右侧操作 -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="16"
              Margin="24 20 24 0">
            <StackPanel Grid.Column="0" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Text="插件"/>
                    <Border x:Name="PnpmBadge"
                            IsVisible="False"
                            VerticalAlignment="Center"
                            CornerRadius="10"
                            Padding="8 2"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <TextBlock x:Name="PnpmBadgeText"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Text="pnpm 未就绪"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="PluginsSubText"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="正在读取插件清单..."/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <ui:FAProgressRing x:Name="PluginsProgress"
                                   Width="20"
                                   Height="20"
                                   IsActive="False"/>
                <Button x:Name="RevealProfileButton"
                        Click="OnRevealProfileClick"
                        ToolTip.Tip="在文件管理器中定位 profile 的 cordis.patch.yml">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="插件目录" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RefreshPluginsButton"
                        Click="OnRefreshPluginsClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="刷新" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- 操作输出:开/关下方的日志浮窗。放页头而不是右下角浮动按钮,
                     既不遮挡列表,也不用给内容留避让边距 -->
                <Button x:Name="PluginLogToggleButton"
                        Click="OnPluginLogToggleClick"
                        ToolTip.Tip="操作输出(安装/卸载/启停的实时输出)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="输出" VerticalAlignment="Center"/>
                        <!-- 浮窗关着时,有新输出就亮一个小圆点 -->
                        <Ellipse x:Name="PluginLogUnreadDot"
                                 Width="8"
                                 Height="8"
                                 IsVisible="False"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource SystemFillColorAttentionBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ② 左右两栏:左=视图切换与选项(窄栏),右=列表。
             列表是本页主体,所以把筛选/来源/手动安装都挪到左栏,把竖向空间全让给列表
             (最小窗口 630 高时,原来那两行筛选要吃掉 ~110px,列表只剩两三行) -->
        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="16"
              Margin="24 16 24 24">

            <!-- 左栏:视图 + 选项。上半部分可滚动(窗口矮时选项放不下),
                 「手动安装」固定在栏底 —— 它是主要操作,不能被滚动挤到看不见。
                 宽 254 = 12(内边距) + 214(控件净宽) + 14(滚动条槽位) + 12(内边距) + 2(边框):
                 预留槽位是因为 Fluent 的滚动条是 **overlay**(画在内容之上),不预留就会遮住控件右边缘 -->
            <Border Grid.Column="0"
                    Width="254"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid RowDefinitions="*,Auto" RowSpacing="10">
                    <ScrollViewer Grid.Row="0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10" Margin="0 0 14 0">

                            <TextBlock Text="视图"
                                       FontSize="12"
                                       Opacity="0.6"/>
                            <ListBox x:Name="PluginsViewList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     SelectionChanged="OnPluginsViewChanged">
                                <ListBoxItem Content="已安装" Tag="installed"/>
                                <ListBoxItem Content="安装新插件" Tag="install"/>
                            </ListBox>

                            <!-- 组合条目筛选(只在「已安装」视图用得上) -->
                            <StackPanel x:Name="EntriesFilterPanel" Spacing="4">
                                <TextBlock Text="筛选组合条目"
                                           FontSize="12"
                                           Opacity="0.6"/>
                                <TextBox x:Name="EntryFilterBox"
                                         PlaceholderText="包名或条目 id"
                                         TextChanged="OnEntryFilterChanged"/>
                            </StackPanel>

                            <!-- 目录选项(只在「安装新插件」视图用得上) -->
                            <StackPanel x:Name="CatalogOptionsPanel"
                                        IsVisible="False"
                                        Spacing="4">
                                <TextBlock Text="目录来源"
                                           FontSize="12"
                                           Opacity="0.6"/>
                                <ComboBox x:Name="CatalogSourceCombo"
                                          HorizontalAlignment="Stretch"
                                          ToolTip.Tip="两份社区目录互为独立:awesome-dsh-plugin 是市场 dsh-market 的数据源;dsh-plugin.org 是插件中心 dsh-plugin-hub 的数据源。"
                                          SelectionChanged="OnCatalogSourceChanged">
                                    <ComboBoxItem Content="awesome-dsh-plugin"/>
                                    <ComboBoxItem Content="dsh-plugin.org"/>
                                </ComboBox>
                                <Button x:Name="RefreshCatalogButton"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Click="OnRefreshCatalogClick"
                                        ToolTip.Tip="重新拉取目录(3-7MB)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="刷新目录" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <TextBlock Text="分类"
                                           FontSize="12"
                                           Opacity="0.6"
                                           Margin="0 6 0 0"/>
                                <ComboBox x:Name="CatalogCategoryCombo"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnCatalogFilterChanged"/>

                                <TextBlock Text="排序"
                                           FontSize="12"
                                           Opacity="0.6"
                                           Margin="0 6 0 0"/>
                                <ComboBox x:Name="CatalogSortCombo"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnCatalogFilterChanged">
                                    <ComboBoxItem Content="按星标"/>
                                    <ComboBoxItem Content="按下载量"/>
                                    <ComboBoxItem Content="按收录时间"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 手动安装:目录里没有的包(本地路径 / 私有仓库)。
                         右边距与上面滚动内容一致,两者右边缘才对齐 -->
                    <StackPanel Grid.Row="1"
                                x:Name="ManualInstallPanel"
                                IsVisible="False"
                                Margin="0 0 14 0"
                                Spacing="4">
                        <TextBlock Text="手动安装"
                                   FontSize="12"
                                   Opacity="0.6"
                                   ToolTip.Tip="用于目录里没有的包(本地路径 / 私有仓库)。目录外的插件没有经过策展校验,只安装你信任的来源。"/>
                        <TextBox x:Name="InstallSpecBox"
                                 PlaceholderText="包名 / tarball / 路径 / git"
                                 KeyDown="OnInstallSpecKeyDown"/>
                        <Button x:Name="InstallPluginButton"
                                Classes="accent"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="OnInstallPluginClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="安装" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右栏:列表(两个视图共用一个位置,靠 IsVisible 切换;
                 隐藏的那一半 IsVisible=false,其控件不在 UIA 树里) -->
            <Grid Grid.Column="1">

                <!-- 已安装视图:批量操作栏(跨两列) + 两列(已安装 | 全部组合条目) -->
                <Grid x:Name="InstalledView"
                      RowDefinitions="Auto,*"
                      RowSpacing="12"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="12">

                    <!-- 批量操作栏:勾选行左边的选择框后在这里统一操作。
                         勾选态存在 PluginEntry 上,所以左右两列(共用同一批实例)天然同步 -->
                    <Border Grid.Row="0"
                            Grid.ColumnSpan="2"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12 8">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                            <CheckBox x:Name="SelectAllBox"
                                      Grid.Column="0"
                                      VerticalAlignment="Center"
                                      Content="全选"
                                      Click="OnSelectAllClick"
                                      ToolTip.Tip="全选/取消全选**当前列表里的条目**(左右两列一起算;若先筛选则只选筛出来的)"/>

                            <TextBlock x:Name="BatchCountText"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Opacity="0.7"
                                       Text="未选择任何条目"/>

                            <StackPanel Grid.Column="3"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Button x:Name="BatchEnableButton"
                                        Content="批量启用"
                                        IsEnabled="False"
                                        Click="OnBatchEnableClick"/>
                                <Button x:Name="BatchDisableButton"
                                        Content="批量禁用"
                                        IsEnabled="False"
                                        Click="OnBatchDisableClick"/>
                                <Button x:Name="BatchResetButton"
                                        Content="恢复默认"
                                        IsEnabled="False"
                                        Click="OnBatchResetClick"/>
                                <Button x:Name="BatchUninstallButton"
                                        Content="批量卸载"
                                        IsEnabled="False"
                                        Click="OnBatchUninstallClick"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 左列:已安装的插件(dsh.profile 的 dependencies) -->
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <Grid RowDefinitions="Auto,*" RowSpacing="4">
                            <StackPanel Grid.Row="0" Spacing="4">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock Text="已安装的插件"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="InstalledCountText"
                                               Grid.Column="1"
                                               FontSize="12"
                                               Opacity="0.7"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="InstalledHintText"
                                           FontSize="12"
                                           Opacity="0.7"
                                           TextWrapping="Wrap"
                                           Text="插件装在这个 profile 里,可启用/禁用,或从 profile 卸载。"/>
                                <StackPanel x:Name="InstalledEmptyPanel"
                                            IsVisible="False"
                                            Margin="0 8 0 0"
                                            Orientation="Horizontal"
                                            Spacing="12">
                                    <TextBlock FontSize="12"
                                               Opacity="0.7"
                                               VerticalAlignment="Center"
                                               Text="尚未安装任何插件。"/>
                                    <Button x:Name="GoToInstallTabButton"
                                            Content="去安装新插件"
                                            Click="OnGoToInstallTabClick"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 列表撑满卡片剩余高度,在卡片内部滚动 -->
                            <ScrollViewer Grid.Row="1"
                                          x:Name="InstalledScroll"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="InstalledPluginsList"
                                              ItemsPanel="{StaticResource PluginListPanel}"
                                              ItemTemplate="{StaticResource PluginRowTemplate}"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- 右列:全部组合条目(原来是折叠 Expander,两列布局下改成常显卡片:
                         它占满整列,折叠起来只会留一片空白) -->
                    <Border Grid.Row="1"
                            Grid.Column="1"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="4">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Text="全部组合条目"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="AllEntriesCountText"
                                           Grid.Column="1"
                                           FontSize="12"
                                           Opacity="0.7"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       FontSize="12"
                                       Opacity="0.7"
                                       TextWrapping="Wrap"
                                       Text="dsh 自带插件与已安装插件组合出的完整 Loader 条目。禁用会写入 profile 的 cordis.patch.yml,重启或重载 dsh 后生效。"/>
                            <ScrollViewer Grid.Row="2"
                                          x:Name="AllEntriesScroll"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="AllEntriesList"
                                              ItemsPanel="{StaticResource PluginListPanel}"
                                              ItemTemplate="{StaticResource PluginRowTemplate}"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 安装新插件视图:搜索行 + 目录列表(来源/分类/排序/手动安装都在左栏)。
                     来源是策展目录(awesome-dsh-plugin 或 dsh-plugin.org,结构自动识别),
                     不是 npm registry;切到本视图时才拉目录,只在内存里留一份,点「刷新目录」重拉 -->
                <Grid x:Name="InstallView"
                      IsVisible="False"
                      RowDefinitions="Auto,*"
                      RowSpacing="8">

                    <TextBox x:Name="CatalogSearchBox"
                             PlaceholderText="搜索插件名 / 作者 / 描述"
                             TextChanged="OnCatalogSearchTextChanged"/>

                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                            <TextBlock x:Name="CatalogStatusText"
                                       FontSize="12"
                                       Opacity="0.7"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Text="正在读取插件目录…"/>

                            <ScrollViewer Grid.Row="1"
                                          x:Name="CatalogListScroll"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="CatalogList"
                                              ItemsPanel="{StaticResource PluginListPanel}"
                                              ItemTemplate="{StaticResource CatalogRowTemplate}"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ③ 点空白处关闭输出浮窗:一层透明的命中层,盖住**内容区**(第 1 行)。
             - 放在浮窗**之前**声明 ⇒ z 序在浮窗之下,浮窗里的复制/清空/关闭按钮不受影响。
             - 只盖内容区、不盖页头 ⇒ 页头的「输出」按钮仍能当开关用(点它关、再点开)。
             - Background 必须给透明画刷:Avalonia 里 null 不参与命中测试,必须 Transparent 才收得到点击 -->
        <Border x:Name="PluginLogDismissLayer"
                Grid.Row="1"
                IsVisible="False"
                Background="Transparent"
                PointerPressed="OnPluginLogDismissPressed"/>

        <!-- 日志浮窗:由页头的「输出」按钮开关。从页头下方垂下来(内容区顶部右对齐),
             不占布局空间;声明在内容与命中层之后,所以盖在它们之上 -->
        <Border x:Name="PluginLogFlyout"
                Grid.Row="1"
                IsVisible="False"
                Width="580"
                Height="340"
                Margin="0 4 20 0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Padding="16"
                CornerRadius="8"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                BoxShadow="0 8 24 4 #40000000">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0 0 0 10">
                    <TextBlock Text="操作输出"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button x:Name="CopyPluginLogButton" Click="OnCopyPluginLogClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CopyPluginLogButtonText" Text="复制" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClearPluginLogButton" Click="OnClearPluginLogClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="清空" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClosePluginLogButton"
                                Click="OnClosePluginLogClick"
                                ToolTip.Tip="关闭输出浮窗">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="14" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Background="{DynamicResource CodeAreaFillBrush}"
                        CornerRadius="4"
                        Padding="10">
                    <ScrollViewer x:Name="PluginLogScroll"
                                  Padding="0 0 12 0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <SelectableTextBlock x:Name="PluginLogTextBlock"
                                             TextWrapping="Wrap"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             LineHeight="18"
                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
